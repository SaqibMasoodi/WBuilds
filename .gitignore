# ==============================================================================
# WBuilds Website - Workspace .gitignore
# Astro project build and environment exclusions
# ==============================================================================

# Node dependencies
node_modules/

# Production build output
dist/

# Astro dev cache and generated type declarations
.astro/

# Environment files
.env
.env.*
!.env.example

# Reference crops and temporary dumps
*ritmere*
*techbeta*
*tech_beta*

# Knowledge graph & analysis
graphify-out/

# Local runner & test files
run.bat
test_thumb.jpg
*.tmp
*.bak
*.swp
*~

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
