---
interface Benefit {
  title: string;
  description: string;
  icon: 'desktop' | 'gamepad' | 'mobile';
}

interface Props {
  heading?: string;
  cards?: Benefit[];
}

const {
  heading = 'Works with all Minecraft editions',
  cards = [
    {
      title: 'Java Edition',
      description: 'Full support for PC & Mac survival worlds with exact coordinate placement, block physics, and redstone timing.',
      icon: 'desktop',
    },
    {
      title: 'Bedrock Edition',
      description: '100% compatible with Windows, Xbox, PlayStation, and Nintendo Switch cross-play realms and servers.',
      icon: 'gamepad',
    },
    {
      title: 'Pocket Edition',
      description: 'Optimized for iOS and Android, so you can follow guides touch-by-touch right on your phone or tablet.',
      icon: 'mobile',
    },
  ],
} = Astro.props;
---

<section class="benefits-section" id="benefits">
  <div class="benefits-container">
    <!-- Left-aligned Header Stack -->
    <div class="benefits-intro">
      <h2 class="benefits-heading">{heading}</h2>
    </div>

    <!-- 3-Card Grid -->
    <div class="benefits-cards">
      {cards.map((card) => (
        <article class="benefit-card">
          <!-- Top Icon -->
          <div class="benefit-icon" aria-hidden="true">
            {card.icon === 'desktop' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
            )}
            {card.icon === 'gamepad' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="6" width="20" height="12" rx="4" />
                <line x1="6" y1="12" x2="10" y2="12" />
                <line x1="8" y1="10" x2="8" y2="14" />
                <circle cx="15.5" cy="10.5" r="0.8" fill="currentColor" />
                <circle cx="17.5" cy="12.5" r="0.8" fill="currentColor" />
              </svg>
            )}
            {card.icon === 'mobile' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="3" />
                <line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2.2" />
              </svg>
            )}
          </div>

          <!-- Bottom Text Stack -->
          <div class="benefit-copy">
            <h3 class="benefit-title">{card.title}</h3>
            <p class="benefit-description">{card.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits-section {
    position: relative;
    width: 100%;
    padding: var(--space-24) var(--space-12);
    background-color: #ffffff;
    display: flex;
    justify-content: center;
  }

  .benefits-container {
    max-width: 1600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  /* Left-Aligned Header */
  .benefits-intro {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .benefits-label-pill {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    background-color: #f4f4f5;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #71717a;
    letter-spacing: -0.1px;
  }

  .benefits-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-section-mobile), 4.5vw, var(--text-4xl));
    font-weight: 400;
    line-height: var(--line-display);
    letter-spacing: var(--tracking-heading);
    color: #111111;
    margin: 0;
    text-wrap: balance;
  }

  /* 3-Card Row */
  .benefits-cards {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .benefit-card {
    position: relative;
    min-height: 0;
    background-color: #f4f4f5;
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 24px;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-8);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.08);
  }

  .benefit-icon {
    width: 28px;
    height: 28px;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .benefit-icon svg {
    width: 26px;
    height: 26px;
  }

  .benefit-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 0;
  }

  .benefit-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111111;
    margin: 0;
  }

  .benefit-description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-body);
    color: #71717a;
    margin: 0;
  }

  /* Responsive Behavior */
  @media (max-width: 1024px) {
    .benefits-section {
      padding: 96px 32px;
    }
    .benefits-cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .benefit-card {
      min-height: auto;
    }
    .benefit-copy {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .benefits-section {
      padding: 80px 20px;
    }
    .benefits-container {
      gap: 32px;
    }
    .benefits-heading {
      font-size: clamp(var(--text-2xl), 8vw, var(--text-section-mobile));
      line-height: var(--line-heading);
    }
    .benefit-card {
      padding: 24px;
      border-radius: 16px;
    }
  }
</style>
