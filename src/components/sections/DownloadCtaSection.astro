---
import { withBase } from '../../utils/paths';
import { siteConfig } from '../../data/site';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  iosLink?: string;
  androidLink?: string;
  platformNote?: string;
}

const {
  eyebrow = 'WBUILDS APP',
  heading = 'Start building the worlds of tomorrow, today.',
  description = 'Get instant access to 600+ step-by-step Minecraft building guides, layer-by-layer blueprints, and exact material calculators. Free on iOS and Android.',
  iosLink = siteConfig.appStoreUrl,
  androidLink = siteConfig.playStoreUrl,
  platformNote = 'Free download · Works with Java, Bedrock & Pocket Edition',
} = Astro.props;
---

<section class="cta-section" id="download">
  <div class="cta-container">
    <div class="cta-card">
      <!-- Left Phone Mockup Graphic -->
      <div class="cta-visual-col">
        <div class="phone-crop-wrap">
          <img
            src={withBase('/mockups/download-app-phone.png')}
            alt="WBuilds Mobile App Blueprint Interface"
            class="phone-mockup-img"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Content Col -->
      <div class="cta-content-col">
        {eyebrow && <span class="cta-eyebrow">{eyebrow}</span>}
        <h2 class="cta-title">{heading}</h2>
        <p class="cta-desc">{description}</p>
        
        <div class="cta-buttons-row">
          <a href={iosLink} target="_blank" rel="noopener noreferrer" class="btn-ios">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.63-.78 1.06-1.85.94-2.94-.92.04-2.02.61-2.67 1.39-.58.67-1.08 1.76-.94 2.81 1.03.08 2.05-.48 2.67-1.26z" />
            </svg>
            <span>Download for iOS</span>
          </a>

          <a href={androidLink} target="_blank" rel="noopener noreferrer" class="btn-android">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5c.67.4.67 1.4 0 1.8l-14 8.5c-.66.5-1.6.03-1.6-.8z" />
            </svg>
            <span>Download for Android</span>
          </a>
        </div>

        {platformNote && (
          <p class="cta-note">{platformNote}</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    width: 100%;
    padding: 0 48px 144px;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
  }

  .cta-container {
    max-width: 1600px;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Main Dark Rounded Card */
  .cta-card {
    width: 100%;
    background-color: #111215;
    border-radius: 32px;
    overflow: hidden;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    min-height: 520px;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.16);
  }

  /* Left Column: Phone Mockup */
  .cta-visual-col {
    position: relative;
    height: 100%;
    min-height: 520px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
  }

  .phone-crop-wrap {
    position: absolute;
    left: 56px;
    top: 50px;
    width: 440px;
    max-width: 90%;
    pointer-events: none;
    transform: rotate(3deg);
    transform-origin: top left;
    transition: transform 0.4s ease;
  }

  .cta-card:hover .phone-crop-wrap {
    transform: rotate(1.5deg) translateY(-6px);
  }

  .phone-mockup-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.55));
  }

  /* Right Column: Copy & CTAs */
  .cta-content-col {
    padding: 64px 64px 64px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 2;
  }

  .cta-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 12px;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.8vw, 46px);
    font-weight: 500;
    line-height: 1.15em;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin: 0;
    max-width: 540px;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6em;
    color: rgba(255, 255, 255, 0.7);
    margin: 18px 0 32px;
    max-width: 480px;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* iOS Button: Solid White */
  .btn-ios {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    background-color: #ffffff;
    color: #111111;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .btn-ios:hover {
    background-color: #f4f4f5;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  /* Android Button: Outlined / Dark */
  .btn-android {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-android:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .cta-note {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 20px;
    letter-spacing: -0.1px;
  }

  /* Responsive Behavior */
  @media (max-width: 1024px) {
    .cta-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .cta-visual-col {
      min-height: 420px;
      order: 2;
      align-items: center;
      justify-content: center;
    }
    .phone-crop-wrap {
      left: 50%;
      top: 30px;
      transform: translateX(-50%);
      width: 380px;
    }
    .cta-content-col {
      padding: 56px 36px 24px;
      align-items: center;
      text-align: center;
      order: 1;
    }
    .cta-buttons-row {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 0 20px 80px;
    }
    .cta-card {
      border-radius: 24px;
    }
    .cta-content-col {
      padding: 40px 24px 20px;
    }
    .cta-buttons-row {
      flex-direction: column;
      width: 100%;
    }
    .btn-ios, .btn-android {
      width: 100%;
      justify-content: center;
    }
    .cta-visual-col {
      min-height: 320px;
    }
    .phone-crop-wrap {
      width: 300px;
      top: 20px;
    }
  }
</style>
