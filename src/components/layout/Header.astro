---
import { withBase } from '../../utils/paths';

interface Props {
  brandName?: string;
}

const { brandName = 'WBuilds' } = Astro.props;
---

<!-- Navigation Bar (Completely hidden by default, visible ONLY via keyboard shortcut: Press 'N') -->
<header class="nav-wrapper" id="site-header" aria-hidden="true">
  <div class="nav-bar">
    <!-- Left Brand Badge -->
    <a href="#home" class="brand-badge" aria-label="WBuilds Home">
      <img
        src={withBase('/brand/wbuilds-icon.webp')}
        alt=""
        class="brand-badge-icon"
        width="22"
        height="22"
      />
      <span class="brand-badge-title">
        <span class="brand-highlight">W</span>Builds<span class="brand-dot">.</span>
      </span>
    </a>

    <!-- Center/Right Navigation Links -->
    <nav class="nav-links" aria-label="Primary Navigation">
      <a href="#home" class="nav-link active">Home</a>
      <a href="#benefits" class="nav-link">Editions</a>
      <a href="#build-progress" class="nav-link">Builds</a>
      <a href="#download" class="nav-link">Download</a>
    </nav>

    <!-- Right Controls: Palette Icon, CTA Button, and Dismiss Button -->
    <div class="nav-actions">
      <!-- Theme/Palette Switcher Icon Button -->
      <button class="nav-icon-btn" id="palette-btn" aria-label="Color Palette Switcher" title="Palette Switcher">
        <svg class="palette-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
          <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
          <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
          <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.4-1.1-.3-.4-.5-.9-.5-1.4 0-1.1.9-2 2-2h1.4c3.9 0 7-3.1 7-7 0-5.5-4.5-9-11-9z" />
        </svg>
      </button>

      <!-- Primary CTA Button -->
      <a href="#download" class="nav-cta-btn">
        <span>Get the app</span>
      </a>

      <!-- Dismiss / Close Navbar Button -->
      <button class="nav-hide-btn" id="nav-hide-btn" aria-label="Hide navigation (Shortcut: N or Esc)" title="Hide navigation (Press N or Esc)">
        <span class="nav-hide-kbd">Esc</span>
        <svg class="nav-hide-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="toggle-line"></span>
        <span class="toggle-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <a href="#home" class="mobile-link">Home</a>
      <a href="#benefits" class="mobile-link">Editions</a>
      <a href="#build-progress" class="mobile-link">Builds</a>
      <a href="#download" class="mobile-link">Download</a>
      <a href="#download" class="mobile-cta">Get the app</a>
    </div>
  </div>
</header>

<script>
  const navWrapper = document.getElementById('site-header');
  const hideBtn = document.getElementById('nav-hide-btn');
  const toggleBtn = document.getElementById('mobile-toggle');
  const drawer = document.getElementById('mobile-drawer');

  let isNavVisible = false;

  function setNavVisibility(visible: boolean) {
    isNavVisible = visible;
    if (navWrapper) {
      navWrapper.classList.toggle('visible', visible);
      navWrapper.setAttribute('aria-hidden', String(!visible));
    }
    if (!visible && drawer && toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.classList.remove('active');
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
    }
  }

  function toggleNav() {
    setNavVisibility(!isNavVisible);
  }

  // Hide button click inside navbar
  if (hideBtn) {
    hideBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setNavVisibility(false);
    });
  }

  // Check if keyboard target is editable text input
  function isEditingText(target: EventTarget | null) {
    if (!target || !(target instanceof HTMLElement)) return false;
    const tag = target.tagName.toLowerCase();
    return tag === 'input' || tag === 'textarea' || target.isContentEditable;
  }

  // Global Keyboard Shortcut listener: Press 'N' to toggle navbar, 'Esc' to close
  window.addEventListener('keydown', (e) => {
    if (isEditingText(e.target)) return;

    // Toggle shortcut: 'N' or 'n', Alt+N, Shift+N, or Ctrl/Cmd+B
    const isNKey = e.key === 'n' || e.key === 'N';
    const isSimpleN = isNKey && !e.ctrlKey && !e.metaKey && !e.altKey;
    const isAltOrShiftN = isNKey && (e.altKey || e.shiftKey);
    const isCtrlB = (e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B');

    if (isSimpleN || isAltOrShiftN || isCtrlB) {
      e.preventDefault();
      toggleNav();
      return;
    }

    // Escape closes navbar if open
    if (e.key === 'Escape' && isNavVisible) {
      e.preventDefault();
      setNavVisibility(false);
    }
  });

  // Clicking outside navbar closes it
  document.addEventListener('click', (e) => {
    if (!isNavVisible) return;
    const target = e.target as HTMLElement | null;
    if (navWrapper && !navWrapper.contains(target)) {
      setNavVisibility(false);
    }
  });

  // Clicking any link in navbar smoothly closes it
  if (navWrapper) {
    navWrapper.querySelectorAll('.nav-link, .nav-cta-btn, .brand-badge').forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(() => setNavVisibility(false), 250);
      });
    });
  }

  // Mobile Drawer Toggle
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
      toggleBtn.classList.toggle('active', !isOpen);
      drawer.classList.toggle('open', !isOpen);
      drawer.setAttribute('aria-hidden', String(isOpen));
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('active');
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        setTimeout(() => setNavVisibility(false), 250);
      });
    });
  }
</script>

<style>
  /* ========================================================
     FIXED FLOATING NAVBAR WRAPPER (100% Hidden by default)
     ======================================================== */
  .nav-wrapper {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 24px;
    pointer-events: none;
    transform: translateY(-140%);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.38s;
  }

  /* Visible State Activated Exclusively via Keyboard Shortcut 'N' */
  .nav-wrapper.visible {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Outer Navbar Bar - BnW Corner Rounding: 16px */
  .nav-bar {
    pointer-events: auto;
    max-width: 1440px;
    width: 100%;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.12), 0 4px 10px -2px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  /* Left Brand Badge */
  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 16px 8px 10px;
    background-color: #111111;
    color: #ffffff;
    border-radius: 10px;
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .brand-badge:hover {
    background-color: #000000;
    transform: translateY(-1px);
  }

  .brand-badge-icon {
    width: 22px;
    height: 22px;
    display: block;
    object-fit: contain;
    border-radius: 4px;
  }

  .brand-badge-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #ffffff;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
  }

  .brand-highlight {
    color: #ffffff;
  }

  .brand-dot {
    color: #a1a1aa;
    margin-left: 1px;
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    margin-right: 12px;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 500;
    color: #52525b;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: #111111;
    background-color: #f4f4f5;
  }

  .nav-link.active {
    color: #111111;
    font-weight: 600;
    background-color: #f0f2f5;
  }

  /* Right Action Controls */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Palette Switcher Icon Button */
  .nav-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #52525b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-icon-btn:hover {
    background-color: #f4f4f5;
    color: #111111;
  }

  .palette-svg {
    width: 18px;
    height: 18px;
  }

  /* Primary CTA Button */
  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    background-color: #111111;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .nav-cta-btn:hover {
    background-color: #000000;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  /* Dismiss / Close Button */
  .nav-hide-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: #f4f4f5;
    color: #52525b;
    cursor: pointer;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 500;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-hide-btn:hover {
    background-color: #e4e4e7;
    color: #111111;
  }

  .nav-hide-kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 600;
    background-color: rgba(0, 0, 0, 0.06);
    padding: 2px 5px;
    border-radius: 4px;
    color: #71717a;
  }

  .nav-hide-icon {
    width: 14px;
    height: 14px;
  }

  /* Mobile Hamburger Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .toggle-line {
    width: 20px;
    height: 2px;
    background-color: #111111;
    border-radius: 2px;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .mobile-toggle.active .toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-toggle.active .toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    pointer-events: auto;
    width: 100%;
    max-width: 1440px;
    max-height: 0;
    overflow: hidden;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1);
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    opacity: 0;
  }

  .mobile-drawer.open {
    max-height: 360px;
    opacity: 1;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    padding: 16px 20px 20px;
    gap: 6px;
  }

  .mobile-link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
    color: #111111;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .mobile-link:hover {
    background-color: #f4f4f5;
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 12px 18px;
    background-color: #111111;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
  }

  /* Responsive Rules */
  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .nav-cta-btn {
      display: none;
    }

    .nav-hide-btn {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .nav-wrapper {
      top: 12px;
      padding: 0 12px;
    }

    .nav-bar {
      height: 54px;
      padding: 4px 6px;
    }

    .brand-badge {
      padding: 6px 12px 6px 8px;
    }

    .brand-badge-title {
      font-size: 13px;
    }
  }
</style>
