---
// Footer.astro
// Follows the BnW reference design + complete WBuilds product specifications:
// - Tier 1: 2-column top grid with Download CTA (dark card with phone mockup) and Weekly Newsletter (off-white card with email input).
// - Tier 2: Dark Charcoal (#111215) master navigation card with:
//   - Left: Brand icon + logo, comprehensive Minecraft guide tagline, 5 circular social icon buttons (Discord, Reddit, Instagram, TikTok, YouTube), and Mojang non-affiliation disclaimer.
//   - Right: 4 distinct link columns (Explore, Support, Legal, Profile) with all key product pages.
//   - Bottom: Copyright bar, quick legal links (Privacy, Terms, Refunds), and an international language/locale switcher pill.
import { siteConfig } from '../../data/site';
import { withBase } from '../../utils/paths';

interface Props {
  email?: string;
}

const { email = siteConfig.socials.email } = Astro.props;

interface NavLink {
  label: string;
  href: string;
  isExternal?: boolean;
}

const exploreLinks: NavLink[] = [
  { label: 'Browse Builds', href: withBase('/#build-progress') },
  { label: 'How It Works', href: withBase('/how-it-works') },
  { label: 'Features', href: withBase('/features') },
  { label: 'WBuilds vs YouTube', href: withBase('/vs-youtube-schematica') },
  { label: 'Reviews & Ratings', href: withBase('/reviews') },
  { label: 'Pricing', href: withBase('/pricing') },
  { label: 'Get the App', href: '#download' },
];

const supportLinks: NavLink[] = [
  { label: 'FAQ', href: withBase('/faq') },
  { label: 'Contact Us', href: withBase('/contact') },
  { label: 'Discord Community', href: siteConfig.socials.discord, isExternal: true },
  { label: 'Reddit Community', href: siteConfig.socials.reddit, isExternal: true },
];

const legalColumnLinks: NavLink[] = [
  { label: 'Terms of Service', href: withBase('/terms-of-service') },
  { label: 'Privacy Policy', href: withBase('/privacy-policy') },
  { label: 'Refund & Cancellation', href: withBase('/refund-policy') },
  { label: 'About Us', href: withBase('/about') },
];

const profileLinks: NavLink[] = [
  { label: 'Sign In', href: 'https://wbuilds.app/signin', isExternal: true },
  { label: 'My Settings', href: 'https://wbuilds.app/settings', isExternal: true },
];

const bottomLegalLinks: NavLink[] = [
  { label: 'Privacy', href: withBase('/privacy-policy') },
  { label: 'Terms', href: withBase('/terms-of-service') },
  { label: 'Refunds', href: withBase('/refund-policy') },
];

const languages = [
  { code: 'en', label: '🇺🇸 English' },
  { code: 'es', label: '🇪🇸 Español' },
  { code: 'fr', label: '🇫🇷 Français' },
  { code: 'pt', label: '🇧🇷 Português' },
  { code: 'de', label: '🇩🇪 Deutsch' },
  { code: 'nl', label: '🇳🇱 Nederlands' },
  { code: 'it', label: '🇮🇹 Italiano' },
  { code: 'ja', label: '🇯🇵 日本語' },
  { code: 'tr', label: '🇹🇷 Türkçe' },
  { code: 'ar', label: '🇸🇦 العربية' },
  { code: 'zh', label: '🇨🇳 简体中文' },
  { code: 'pl', label: '🇵🇱 Polski' },
  { code: 'cs', label: '🇨🇿 Čeština' },
  { code: 'ro', label: '🇷🇴 Română' },
  { code: 'id', label: '🇮🇩 Bahasa Indonesia' },
  { code: 'ru', label: '🇷🇺 Русский' },
  { code: 'uk', label: '🇺🇦 Українська' },
  { code: 'vi', label: '🇻🇳 Tiếng Việt' },
  { code: 'th', label: '🇹🇭 ไทย' },
  { code: 'ko', label: '🇰🇷 한국어' },
  { code: 'sv', label: '🇸🇪 Svenska' },
];
---

<footer class="site-footer-section" id="footer">
  <div class="footer-wrapper">
    <!-- ========================================================
         TIER 1: TOP 2-COLUMN GRID (Download Card + Newsletter Card)
         ======================================================== -->
    <div class="footer-top-grid">
      <!-- Left Card: Download CTA Card (Dark Surface, No Border, Vertically Thinner) -->
      <div class="card-download" id="download">
        <div class="card-download-content">
          <h2 class="card-download-title">
            Build anything in Minecraft,<br />step by step.
          </h2>
          <p class="card-download-subtitle">
            600+ blueprint guides with complete material lists. Free on iOS & Android.
          </p>
          <div class="card-download-actions">
            <a href={siteConfig.appStoreUrl} target="_blank" rel="noopener noreferrer" class="store-btn btn-ios">
              <svg class="store-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.63-.78 1.06-1.85.94-2.94-.92.04-2.02.61-2.67 1.39-.58.67-1.08 1.76-.94 2.81 1.03.08 2.05-.48 2.67-1.26z" />
              </svg>
              <span>Download for iOS</span>
            </a>
            <a href={siteConfig.playStoreUrl} target="_blank" rel="noopener noreferrer" class="store-btn btn-android">
              <svg class="store-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5c.67.4.67 1.4 0 1.8l-14 8.5c-.66.5-1.6.03-1.6-.8z" />
              </svg>
              <span>Download for Android</span>
            </a>
          </div>
        </div>

        <!-- Phone Mockup Positioned Exactly as in Reference Image -->
        <div class="card-download-mockup" aria-hidden="true">
          <img
            src={withBase('/mockups/download-app-phone.png')}
            alt=""
            class="mockup-phone-image"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Card: Newsletter Card (Light Off-White Surface, Subtle BnW Border #f0f0f0) -->
      <div class="card-newsletter">
        <div class="card-newsletter-inner">
          <div class="newsletter-text-block">
            <h3 class="newsletter-title">
              A small note.<br />A fresh start.
            </h3>
            <p class="newsletter-subtitle">
              Thoughtful building tips and WBuilds updates, occasionally.
            </p>
          </div>

          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to WBuilds weekly!');">
            <div class="newsletter-input-group">
              <input
                type="email"
                class="newsletter-field"
                placeholder="Enter your email"
                required
                aria-label="Enter your email"
              />
              <button type="submit" class="newsletter-submit-button" aria-label="Subscribe">
                <svg class="submit-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================================
         TIER 2: BOTTOM NAVIGATION & BRAND CARD
         ======================================================== -->
    <div class="card-dark footer-nav-card">
      <div class="footer-nav-main">
        <!-- Col 1: Identity, Tagline, Socials & Disclaimer -->
        <div class="footer-col-identity">
          <a href="#home" class="footer-brand" aria-label="WBuilds Home">
            <img src={withBase('/brand/wbuilds-icon.webp')} alt="" class="footer-brand-icon" width="28" height="28" />
            <span class="footer-brand-title">
              <span class="brand-highlight">W</span>Builds<span class="brand-dot">.</span>
            </span>
          </a>
          <p class="footer-tagline">
            Minecraft build guide for house and castle tutorials and more, step by step with exact material lists, for Java, Bedrock and Pocket Edition players.
          </p>

          <!-- 5 Circular Social Media Buttons -->
          <div class="footer-socials-row" aria-label="WBuilds Social Channels">
            <!-- Discord -->
            <a
              href={siteConfig.socials.discord}
              class="social-icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Join WBuilds Discord Community"
              title="Discord"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="social-svg">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
              </svg>
            </a>

            <!-- Reddit -->
            <a
              href={siteConfig.socials.reddit}
              class="social-icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Join WBuilds Reddit Community"
              title="Reddit"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="social-svg">
                <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z" />
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href={siteConfig.socials.instagram}
              class="social-icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow WBuilds on Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="social-svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
              </svg>
            </a>

            <!-- TikTok -->
            <a
              href={siteConfig.socials.tiktok}
              class="social-icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow WBuilds on TikTok"
              title="TikTok"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="social-svg">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href={siteConfig.socials.youtube}
              class="social-icon-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Subscribe to WBuilds on YouTube"
              title="YouTube"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="social-svg">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            </a>
          </div>

          <!-- Mojang / Microsoft Non-Affiliation Disclaimer (Mandatory Requirement) -->
          <p class="footer-disclaimer">
            This app is an independent tool designed to help Minecraft players. Not affiliated with Mojang Studios or Microsoft.
          </p>

          <!-- Support Contact Email -->
          <a href={`mailto:${email}`} class="footer-email-link">
            <span>{email}</span>
            <svg class="email-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </div>

        <!-- Col 2: 4-Column Navigation Grid -->
        <div class="footer-columns-grid">
          <!-- Col 2A: Explore -->
          <div class="footer-links-group">
            <h3 class="footer-col-heading">Explore</h3>
            <nav class="footer-links-list" aria-label="Explore Navigation">
              {exploreLinks.map((link) => (
                <a href={link.href} class="footer-nav-link">{link.label}</a>
              ))}
            </nav>
          </div>

          <!-- Col 2B: Support -->
          <div class="footer-links-group">
            <h3 class="footer-col-heading">Support</h3>
            <nav class="footer-links-list" aria-label="Support Navigation">
              {supportLinks.map((link) => (
                <a
                  href={link.href}
                  class="footer-nav-link"
                  target={link.isExternal ? '_blank' : undefined}
                  rel={link.isExternal ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <!-- Col 2C: Legal -->
          <div class="footer-links-group">
            <h3 class="footer-col-heading">Legal</h3>
            <nav class="footer-links-list" aria-label="Legal Navigation">
              {legalColumnLinks.map((link) => (
                <a href={link.href} class="footer-nav-link">{link.label}</a>
              ))}
            </nav>
          </div>

          <!-- Col 2D: Profile -->
          <div class="footer-links-group">
            <h3 class="footer-col-heading">Profile</h3>
            <nav class="footer-links-list" aria-label="Profile Navigation">
              {profileLinks.map((link) => (
                <a
                  href={link.href}
                  class="footer-nav-link"
                  target={link.isExternal ? '_blank' : undefined}
                  rel={link.isExternal ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </div>

      <!-- Legal & Copyright Bar with Language Selector -->
      <div class="footer-nav-bottom">
        <p class="copyright-text">© {new Date().getFullYear()} WBuilds. All rights reserved.</p>

        <div class="footer-bottom-right">
          <nav class="bottom-legal-nav" aria-label="Quick Legal Navigation">
            {bottomLegalLinks.map((link) => (
              <a href={link.href} class="legal-link">{link.label}</a>
            ))}
          </nav>

          <!-- Language / Locale Switcher Pill -->
          <div class="footer-lang-pill">
            <svg class="footer-lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
            </svg>
            <label class="sr-only" for="footer-language-select">Select language</label>
            <select id="footer-language-select" class="footer-lang-select" aria-label="Select language">
              {languages.map((lang) => (
                <option value={lang.code} selected={lang.code === 'en'}>
                  {lang.label}
                </option>
              ))}
            </select>
            <svg class="footer-lang-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ========================================================
     FOOTER SECTION ROOT & WRAPPER
     ======================================================== */
  .site-footer-section {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
    padding: 0 48px 48px;
    box-sizing: border-box;
  }

  .footer-wrapper {
    max-width: 1600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Universal Dark Container for Footer Nav (Seamless solid dark, no border) */
  .card-dark {
    background-color: #111215;
    border-radius: 24px;
    border: none;
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.18);
    box-sizing: border-box;
  }

  /* ========================================================
     TIER 1: TOP 2-COLUMN GRID (Download + Newsletter)
     ======================================================== */
  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.8fr minmax(330px, 1fr);
    gap: 20px;
    width: 100%;
    align-items: stretch;
  }

  /* --- LEFT CARD: DOWNLOAD CTA (Solid Dark #111215, Vertically Thinner: min-height 280px, No Border) --- */
  .card-download {
    position: relative;
    overflow: hidden;
    background-color: #111215;
    border-radius: 24px;
    border: none;
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.18);
    display: flex;
    align-items: center;
    min-height: 280px;
    box-sizing: border-box;
  }

  .card-download-content {
    position: relative;
    z-index: 2;
    padding: 36px 40px;
    width: 60%;
    max-width: 540px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .card-download-title {
    font-family: var(--font-heading, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: clamp(22px, 1.9vw, 28px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.6px;
    color: #ffffff;
    margin: 0;
  }

  .card-download-subtitle {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.15px;
    color: rgba(255, 255, 255, 0.7);
    margin: 8px 0 0;
    max-width: 440px;
  }

  /* Buttons Row: Strictly Side-by-Side (nowrap) on Desktop */
  .card-download-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

